{
  "entities": {
    "User": {
      "title": "User",
      "description": "Admin or owner of the portal.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["OWNER", "ADMIN"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role", "createdAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Incoming leads or inquiries.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "company": { "type": "string", "maxLength": 100 },
        "website": { "type": "string", "maxLength": 200 },
        "serviceInterest": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 2000 },
        "budgetRange": { "type": "string", "maxLength": 50 },
        "source": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["NEW", "QUALIFIED", "CONTACTED", "MEETING", "QUOTED", "WON", "LOST"] },
        "priority": { "type": "string", "enum": ["LOW", "NORMAL", "HIGH", "URGENT"] },
        "ownerId": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 5000 },
        "convertedClientId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "status", "createdAt", "updatedAt"]
    },
    "Client": {
      "title": "Client",
      "description": "Persistent business record.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "company": { "type": "string", "maxLength": 100 },
        "primaryContact": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "website": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "createdAt", "updatedAt"]
    },
    "ActivityEvent": {
      "title": "Activity Event",
      "description": "Chronological business events.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "maxLength": 50 },
        "actorId": { "type": "string", "maxLength": 128 },
        "entityType": { "type": "string", "maxLength": 50 },
        "entityId": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["type", "actorId", "entityType", "entityId", "description", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Portal user accounts"
    },
    "inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Leads and inquiries"
    },
    "clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Converted clients"
    },
    "activity/{activityId}": {
      "schema": { "$ref": "#/entities/ActivityEvent" },
      "description": "System activity logs"
    }
  }
}
