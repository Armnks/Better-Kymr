rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAuthorized() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner() {
      return isAuthorized() && getUserDoc().data.role == 'OWNER';
    }

    function isOwnerOrAdmin() {
      return isAuthorized() && getUserDoc().data.role in ['OWNER', 'ADMIN'];
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Users ---
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.email is string && data.email.size() <= 100 &&
             data.role is string && data.role in ['OWNER', 'ADMIN', 'MEMBER'] &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      // Users can always read their own document to check their role.
      // Anyone on the team can read team members.
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAuthorized();
      
      // ONLY existing Owners/Admins can create new users, and they cannot create an OWNER.
      // Initial OWNER must be created manually in Firebase Console.
      allow create: if isOwnerOrAdmin() && isValidId(userId) &&
                       isValidUser(incoming()) && incoming().createdAt == request.time &&
                       (isOwner() || incoming().role != 'OWNER');
                       
      // Owner can update anything. Users can update themselves but CANNOT change their role.
      allow update: if isAuthorized() && isValidId(userId) &&
                       isValidUser(incoming()) && incoming().createdAt == existing().createdAt &&
                       (isOwner() || (userId == request.auth.uid && incoming().role == existing().role));
                       
      // Only Owner can delete users
      allow delete: if isOwner();
    }

    // --- Inquiries ---
    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'status', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() <= 100 &&
             data.status is string && data.status in ["NEW", "QUALIFIED", "CONTACTED", "MEETING", "QUOTED", "WON", "LOST"] &&
             data.createdAt is timestamp && data.updatedAt is timestamp &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('company' in data) || (data.company is string && data.company.size() <= 100)) &&
             (!('website' in data) || (data.website is string && data.website.size() <= 200)) &&
             (!('serviceInterest' in data) || (data.serviceInterest is string && data.serviceInterest.size() <= 100)) &&
             (!('message' in data) || (data.message is string && data.message.size() <= 2000)) &&
             (!('budgetRange' in data) || (data.budgetRange is string && data.budgetRange.size() <= 50)) &&
             (!('source' in data) || (data.source is string && data.source.size() <= 50)) &&
             (!('submissionType' in data) || (data.submissionType is string && data.submissionType.size() <= 50)) &&
             (!('scopeRequest' in data) || data.scopeRequest is map) &&
             (!('externalBookingId' in data) || (data.externalBookingId is string && data.externalBookingId.size() <= 100)) &&
             (!('priority' in data) || (data.priority is string && data.priority in ["LOW", "NORMAL", "HIGH", "URGENT"])) &&
             (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
             (!('convertedClientId' in data) || (data.convertedClientId is string && data.convertedClientId.size() <= 128));
    }

    function isSafePublicInquiry(data) {
      return isValidInquiry(data) &&
             data.status == "NEW" &&
             !('priority' in data) &&
             !('ownerId' in data) &&
             !('notes' in data) &&
             !('convertedClientId' in data);
    }

    match /inquiries/{inquiryId} {
      allow read: if isAuthorized();
      
      // Authorized CRM users can create full inquiries. Anyone (including unauth or random logged-in users) can submit a public inquiry.
      allow create: if (isAuthorized() && isValidId(inquiryId) && isValidInquiry(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time) ||
                       (isValidId(inquiryId) && isSafePublicInquiry(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time);
                       
      allow update: if isAuthorized() && isValidId(inquiryId) &&
                       isValidInquiry(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time;
      allow delete: if isAuthorized() && isValidId(inquiryId);
    }

    // --- Clients ---
    function isValidClient(data) {
      return data.keys().hasAll(['name', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() <= 100 &&
             data.createdAt is timestamp && data.updatedAt is timestamp &&
             (!('company' in data) || (data.company is string && data.company.size() <= 100)) &&
             (!('primaryContact' in data) || (data.primaryContact is string && data.primaryContact.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('website' in data) || (data.website is string && data.website.size() <= 200)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000));
    }

    match /clients/{clientId} {
      allow read: if isAuthorized();
      allow create: if isAuthorized() && isValidId(clientId) &&
                       isValidClient(incoming()) && 
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isAuthorized() && isValidId(clientId) &&
                       isValidClient(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time;
      allow delete: if isOwnerOrAdmin() && isValidId(clientId);
    }

    // --- Activity ---
    function isValidActivity(data) {
      return data.keys().hasAll(['type', 'actorId', 'entityType', 'entityId', 'description', 'createdAt']) &&
             data.type is string && data.type.size() <= 50 &&
             data.actorId is string && data.actorId.size() <= 128 &&
             data.entityType is string && data.entityType.size() <= 50 &&
             data.entityId is string && data.entityId.size() <= 128 &&
             data.description is string && data.description.size() <= 500 &&
             data.createdAt is timestamp;
    }

    match /activity/{activityId} {
      allow read: if isAuthorized();
      allow create: if isAuthorized() && isValidId(activityId) &&
                       isValidActivity(incoming()) && 
                       incoming().createdAt == request.time;
      allow update: if false; // Activity logs are immutable
      allow delete: if false; // Activity logs are immutable
    }

    // --- Other CRM Collections ---
    match /meetings/{id} { allow read, write: if isAuthorized(); }
    match /projects/{id} { allow read, write: if isAuthorized(); }
    match /tasks/{id} { allow read, write: if isAuthorized(); }
    match /quotes/{id} { allow read, write: if isAuthorized(); }
    match /invoices/{id} { allow read, write: if isAuthorized(); }
    match /catalogServices/{id} { allow read, write: if isAuthorized(); }
    match /serviceCategories/{id} { allow read, write: if isAuthorized(); }
    match /deliverables/{id} { allow read, write: if isAuthorized(); }
    match /payments/{id} { allow read, write: if isAuthorized(); }
  }
}
