    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.35.0",
    "motion": "^12.23.24",
