# ============================================================
# PUBLIC / CLIENT VARIABLES (Prefix with VITE_ if needed by Vite)
# ============================================================
# Firebase client config requires these, but they are currently loaded
# via `firebase-applet-config.json` instead of env vars in this architecture.
# Do NOT put server secrets here.

# ============================================================
# SERVER-ONLY VARIABLES
# ============================================================
# URL of the public website for CORS configuration
PUBLIC_WEBSITE_URL="https://kymrstudio.com"

# Secret matching the one configured in Cal.com Webhooks UI
CALCOM_WEBHOOK_SECRET="your_calcom_webhook_secret_here"

# Required for Vercel or local development without Application Default Credentials (ADC).
# Must be a raw JSON string of a Google Service Account key with Firestore Editor access.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "gen-lang-client-0467065981", ...}'

# Google Workspace / Calendar integration (Not currently active)
# GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=""
# GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=""
