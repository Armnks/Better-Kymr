# ============================================================
# PUBLIC / CLIENT VARIABLES (Prefix with VITE_ if needed by Vite)
# ============================================================
# Firebase client config requires these, but they are currently loaded
# via `firebase-applet-config.json` instead of env vars in this architecture.
# Do NOT put server secrets here.

# ============================================================
# SERVER-ONLY VARIABLES
# ============================================================
# URL of the public website for CORS configuration
PUBLIC_WEBSITE_URL="https://kymrstudio.com"

# Secret matching the one configured in Cal.com Webhooks UI
CALCOM_WEBHOOK_SECRET="your_calcom_webhook_secret_here"

# ------------------------------------------------------------
# KEYLESS VERCEL AUTH (Workload Identity Federation)
# ------------------------------------------------------------
GCP_PROJECT_NUMBER=""
GCP_SERVICE_ACCOUNT_EMAIL="kymr-vercel-backend@gen-lang-client-0467065981.iam.gserviceaccount.com"
GCP_WORKLOAD_IDENTITY_POOL_ID="vercel-pool"
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID="vercel-oidc"

# Legacy Fallback ONLY (If Keyless WIF or ADC is unavailable)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "gen-lang-client-0467065981", ...}'

# Google Workspace Server-Side OAuth variables
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/google/auth/callback" # Update to production URL in Vercel
ENCRYPTION_KEY="" # Must be exactly 32 characters long
